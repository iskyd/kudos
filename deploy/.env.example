# KudOS configuration. Copy to .env next to docker-compose.yml and adjust.
# Empty values count as unset.

# ---------- docker-compose.yml ----------

# The image version to run, without the leading "v": a release tag from
# https://github.com/iskyd/kudos/releases. Change it to upgrade.
KUDOS_VERSION=1.0.0

# The database password. Required. Generate one: `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

# Host port for the web app. Default: 8080.
# KUDOS_PORT=8080

# ---------- The server ----------

# PostgreSQL + TimescaleDB connection string. Required.
# docker-compose.yml builds it from POSTGRES_PASSWORD; set it only when you run
# the server yourself.
# DATABASE_URL=postgres://kudos:change-me@localhost:5432/kudos?sslmode=disable

# AES-256-GCM key that encrypts Garmin keys, Garmin tokens and LLM API keys.
# 32 random bytes, base64-encoded: `openssl rand -base64 32`.
# Set exactly one of the two. Prefer the file (a Docker secret).
# Losing this key makes stored secrets unrecoverable; never store it in the database.
# docker-compose.yml reads it from ./encryption_key as a Docker secret; set one
# of these only when you run the server yourself.
# ENCRYPTION_KEY_FILE=/run/secrets/kudos_encryption_key
# ENCRYPTION_KEY=

# Allow new accounts to self-register. Turn off after setup. Default: true.
REGISTRATION_ENABLED=true

# Address the HTTP server listens on. Default: :8080.
LISTEN_ADDR=:8080

# Directory for original activity files (gzip-compressed). Default: /data.
DATA_DIR=/data

# Raster map tile URL template with {z}, {x} and {y}.
# Default: https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Garmin Personal API host. Change only to point tests at a fake Garmin.
# Default: https://personal.connectapi.garmin.com
# GARMIN_API_URL=

# debug, info, warn or error. Default: info.
LOG_LEVEL=info
